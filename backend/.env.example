# Database (SQLite for local dev, PostgreSQL for production)
# DATABASE_URL=sqlite:///./drivescore.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drivescore

DATABASE_URL=postgresql+psycopg://drivescore:drivescore@localhost:5432/drivescore
TEST_DATABASE_URL=postgresql+psycopg://drivescore:drivescore@localhost:5432/drivescore_test

# API Keys (comma-separated for multiple)
INSURER_API_KEY=change-me-insurer-key
DRIVER_API_KEY_SALT=change-me-salt

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Storage
DATA_DIR=./data/raw

# Model
MODEL_PATH=./models/model.pkl

# Processing
TRIP_MIN_DISTANCE_KM=1.0
TRIP_MAX_GPS_GAP_S=30.0
TRIP_MIN_DURATION_S=60.0
